{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 3000
    },
    {
      "name": "backend-test",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "app.main:app", "--port", "8001"],
      "env": { "CORS_ORIGINS": "[\"http://localhost:3001\"]" },
      "port": 8001
    },
    {
      "name": "frontend-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--prefix", "frontend", "--", "--port", "3001"],
      "env": { "NEXT_PUBLIC_API_URL": "http://localhost:8001" },
      "port": 3001
    }
  ]
}
